rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catálogo de Peças Artesanais (JËZ Collection)
    // Leitura pública para todos os visitantes da vitrine
    // Gravação e atualização permitidas para a gestão do ateliê
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Configurações globais da vitrine (ex: peça em destaque no Hero Polaroid)
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Fila de Produção do Ateliê (JEZ-044)
    // Singleton meta/production_queue: backlog em dias úteis e pedidos sob
    // encomenda ativos. O checkout incrementa dentro de runTransaction e a
    // vitrine assina o documento em tempo real. Sem delete: a fila nunca
    // pode ser apagada acidentalmente pelo cliente.
    match /meta/production_queue {
      allow read: if true;
      allow create, update: if true;
    }

    // Pedidos de Clientes
    // Qualquer cliente na internet pode registrar um novo pedido ao concluir a compra
    // Leitura, atualização de status e despacho para o painel do ateliê
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}
