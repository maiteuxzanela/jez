# Ignorar tudo por padrao no repositorio (mantem documentos e notas privadas estritamente locais)
/*

# Excecoes permitidas no repositorio:
!/.gitignore
!/.nojekyll
!/index.html
!/site/
!/site/**
!/.firebaserc
!/firebase.json
!/firestore.rules
!/.github/
!/.github/**
!/presentation/
!/presentation/**
!/AGENTS.md
!/.agents/
!/.agents/**
!/personas/
!/personas/**

# Arquivos de sistema e temporarios
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp
*.swo
*~
